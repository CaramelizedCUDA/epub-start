{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-v2-docs/main/tauri.conf.json",
  "productName": "EpubStart",
  "version": "0.1.0",
  "identifier": "com.epubstart.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EpubStart",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' epub: http://epub.localhost; img-src 'self' epub: http://epub.localhost data: asset: http://asset.localhost; font-src 'self' epub: http://epub.localhost; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost epub: http://epub.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/covers/**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
