{
  "name": "epub-start",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:arch": "node epubstart-e2e/scripts/check-architecture.mjs --root src",
    "test:frontend": "node scripts/test-frontend.mjs",
    "test:e2e:unit": "npm --prefix epubstart-e2e test",
    "test:e2e:harness": "npm --prefix epubstart-e2e run fixtures && node epubstart-e2e/scripts/e2e.mjs harness",
    "test:e2e:app": "npm --prefix epubstart-e2e run fixtures && node epubstart-e2e/scripts/e2e.mjs app",
    "audit:android-release": "node scripts/audit-android-release.mjs",
    "audit:unwrap": "node scripts/audit-unwrap.mjs",
    "audit:check": "node scripts/audit-unwrap.mjs --check",
    "check:fast": "npm run typecheck && npm run check:arch && npm run test:frontend && npm run audit:check && npm run test:e2e:unit",
    "gate:staged": "node scripts/run-staged-gate.mjs",
    "hooks:install": "git config core.hooksPath scripts/git-hooks"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "epubjs": "^0.3.93",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
