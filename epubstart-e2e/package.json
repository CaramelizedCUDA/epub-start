{
  "name": "epubstart-e2e",
  "private": true,
  "type": "module",
  "description": "EpubStart reader regression suite: static architecture checks, pagination invariants, synthetic EPUB fixtures",
  "scripts": {
    "fixtures": "node scripts/make-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "test:static": "node scripts/check-architecture.mjs",
    "test:static:self": "node scripts/check-architecture.mjs --self-check",
    "test:unit": "node --test \"tests/**/*.test.ts\"",
    "selftest": "node e2e/selftest/run.mjs",
    "test:e2e": "node scripts/e2e.mjs harness",
    "test:e2e:update": "node scripts/e2e.mjs harness --update-snapshots",
    "test": "npm run typecheck && npm run test:static:self && npm run test:static -- --root ../src && npm run test:unit && npm run selftest",
    "test:e2e:app": "node scripts/e2e.mjs app",
    "test:e2e:mock": "node scripts/e2e.mjs mock"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "epubjs": "0.3.93",
    "jszip": "^3.10.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
